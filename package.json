  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.5",
    "allure-commandline": "^2.37.0",
    "allure-playwright": "^3.6.0",
    "dotenv": "^17.3.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "playwright-mcp": "^0.0.10"
  }
