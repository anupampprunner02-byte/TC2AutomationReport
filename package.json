{
  "name": "playwright-base-framework",
  "version": "1.0.0",
  "description": "Generic Playwright + TypeScript QA automation framework using Page Object Model with Claude Code integration",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "allure:generate": "allure generate ./allure-results --clean",
    "allure:open": "allure open",
    "tc:parse": "npx tsx test-management/parse-testcases.ts",
    "tc:parse:file": "npx tsx test-management/parse-testcases.ts",
    "tc:next": "npx tsx test-management/next-testcase.ts",
    "tc:status": "npx tsx test-management/next-testcase.ts status",
    "tc:done": "npx tsx test-management/next-testcase.ts done",
    "tc:skip": "npx tsx test-management/next-testcase.ts skip",
    "tc:show": "npx tsx test-management/next-testcase.ts show"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anupampprunner02-byte/TC2AutomationReport.git"
  },
